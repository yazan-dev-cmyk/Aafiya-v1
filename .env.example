# ==============================================================================
# AAFIYA — FRONTEND ENVIRONMENT TEMPLATE
# ==============================================================================
# This is a generic template for the Next.js frontend application.
# Copy this file to .env.local for local development.
#
# DO NOT commit sensitive secrets or API keys into repository-tracked files.
# All NEXT_PUBLIC_* variables are exposed to the client bundle.
# ==============================================================================

# Core Application Settings
NEXT_PUBLIC_APP_NAME="Aafiya — المنصة الوطنية الطبية الموحدة"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# Backend REST API Endpoint (Centralized via src/lib/api.ts)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
